  "panels": [
    {
      "title": "Indexer — deposits / withdrawals",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(zkpool_indexer_deposits_total[1m])",
          "legendFormat": "deposits / sec",
          "refId": "A"
        },
        {
          "expr": "rate(zkpool_indexer_withdrawals_total[1m])",
          "legendFormat": "withdrawals / sec",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Indexer lag (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "zkpool_indexer_lag_seconds",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Tree size (leaves)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "zkpool_indexer_tree_size",
          "legendFormat": "leaves",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Errors (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "zkpool_tree_errors_total + zkpool_indexer_errors_total + zkpool_db_errors_total",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Tree add_leaf — p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(zkpool_tree_add_leaf_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(zkpool_tree_add_leaf_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(zkpool_tree_add_leaf_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Tree hash_2 — p50 / p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(zkpool_tree_hash_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(zkpool_tree_hash_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    }
  ],
